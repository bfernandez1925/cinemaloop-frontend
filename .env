# Config web pública de Firebase para cinemaloop-platform — no son
# secretos (ver .gitignore): Firebase depende de las reglas de
# seguridad de Firestore/Auth, no de ocultar este archivo. Generada con
# `firebase apps:sdkconfig WEB <appId> --project cinemaloop-platform`.
#
# En `.env` (no `.env.production`) para que también esté disponible en
# `next dev` — Next.js solo carga `.env.production` en `next build`/
# `next start`, y hoy no hay un proyecto de Firebase distinto por entorno.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBfXgjAF90xk2CbQtZxoyvLNdl49LaDCb4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cinemaloop-platform.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cinemaloop-platform
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cinemaloop-platform.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=719145252486
NEXT_PUBLIC_FIREBASE_APP_ID=1:719145252486:web:25eb276a5b8d7bef970307
