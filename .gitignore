# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env es una excepción deliberada: solo contiene la config web pública
# de Firebase (apiKey, authDomain...), no secretos — Firebase depende de
# las reglas de seguridad de Firestore/Auth, no de ocultar este archivo.
# Hace falta en build time (export estático, tanto en CI como en
# cualquier máquina que compile el proyecto) y en `next dev` — por eso
# es `.env`, no `.env.production` (Next.js solo carga ese en build/start).
!.env

# vercel
.vercel

# firebase (cachés y logs locales de despliegue de Hosting)
.firebase/
firebase-debug.log

# typescript
*.tsbuildinfo
next-env.d.ts

# archivos generados automáticamente por `next dev`, no forman parte del código fuente del proyecto
/CLAUDE.md
/AGENTS.md

# testing e2e (Playwright)
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# editores e IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# sistema operativo
Thumbs.db
Desktop.ini
.directory

# logs
*.log
logs/

# archivos locales de configuración de herramientas que no deben compartirse
*.local
